NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Optional server timings; contains no rows, parameters or identifiers.
RELAY_PERFORMANCE_LOGS=0

# Optional Web Push. Public VAPID key only; never put private keys in NEXT_PUBLIC_*.
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:YOUR_CONTACT_EMAIL
# Server-only existing Supabase service_role key. Never use in a client component.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only random token (32+ characters) for the scheduled dispatcher.
PUSH_DISPATCH_TOKEN=
